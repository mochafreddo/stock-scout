<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.stock-scout.dot</string>
  <key>ProgramArguments</key>
  <array><string>/absolute/machine-local/path/to/run-stock-scout-dot</string></array>
  <key>StandardOutPath</key><string>/absolute/private/log/directory/stdout.log</string>
  <key>StandardErrorPath</key><string>/absolute/private/log/directory/stderr.log</string>
  <!-- launchd interprets this in the Mac's local timezone. This example assumes Asia/Seoul. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>20</integer>
    <key>Minute</key><integer>55</integer>
  </dict>
  <key>ExitTimeOut</key><integer>90</integer>
</dict>
</plist>
